# Copy to .env.local and fill in from your Supabase project settings.

# Safe to expose: the anon key only allows the reads our policies permit.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used by `npm run seed` only. Never commit this or ship it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
